config_version=5

[application]
config/name="keycount pet"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)

[display]
window/size/viewport_width=380
window/size/viewport_height=380
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/resizable=false
# 关键：让 Godot 在**创建窗口时**就带上 NO_FOCUS（→ WS_EX_NOACTIVATE）。
# 实测过：只在 _ready 里 set_flag 太晚，Godot 已经把窗口激活了，
# 结果 `GetGUIThreadInfo` 拿到的 hwndFocus 就是宠物 —— 你随手打的字会落进它里。
window/size/no_focus=true
window/per_pixel_transparency/allowed=true

[rendering]
# 必须用 Compatibility：本机实测 Vulkan/Forward+ 下透明窗口会变成纯黑方块
renderer/rendering_method="gl_compatibility"
viewport/transparent_background=true

[keycount]
# 本工程的版本号（方案 F：v0.1.日期）。发布流程会在导出前把它覆盖成真 tag，
# 本地开发就是 dev。它会被写进 run_log.version —— 回答「这些计数是哪个版本写的」。
version="dev"
# 为什么不用 application/config/version：实测 4.7.2 下那个键读出来是空串（被当成内置默认值）。
# 坑：本文件（project.godot）的注释里**不能出现等号** —— 实测 Godot 4.7.2 会报
#     Error parsing ...: Expected value, got 'ERROR' File might be corrupted，整个项目加载不了。
