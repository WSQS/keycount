# ---- 构建产物（可随时重建，不进仓库）----
gdext/godot-cpp/
gdext/bin/
gdext/.sconsign*
gdext/api/extension_api.json
*.obj
*.exp
*.lib
*.pdb
*.ilk
*.idb

# 扩展编出来的 dll（pet 里那份是拷贝，由 run-pet.ps1 或 scons 生成）
pet/addons/keycount/bin/

# clangd / LSP 产物：compile_commands.json 由 `scons ... compiledb` 生成，.cache 是 clangd 的索引
gdext/compile_commands.json
gdext/.cache/
gdext/.kctest-built

# 独立验证 exe
native/test_hook.exe
native/test_store.exe
native/sqlite3.o
native/test_store.db*

# C# 探针（早前验证钩子用的，保留源码即可）
agent-test/cs-probe/bin/
agent-test/cs-probe/obj/

# ---- Godot ----
pet/.godot/
*.import
# 注意：export_presets.cfg **故意入库** —— release 工作流要用它做导出（Windows Desktop 预设，
# 里面没有机密）。以后若加 Android 签名之类的东西，再单独排除。

# ---- 导出产物（dist/：scons 编的 dll + godot --export 出的 exe/pck）----
dist/
# ---- CI 的临时目录（Godot 编辑器 / 导出模板缓存）----
.ci/

# ---- 运行产物：日志与原始全屏截图（可随时重新生成）----
*.log
agent-test/spike-godot/stdout*.txt
agent-test/spike-godot/godot-stdout.txt
agent-test/spike-godot/run*.log
agent-test/spike-godot/full-*.png
shots/full-*.png
pet/run.log
pet/stdout*.txt
pet/import.txt
pet/settings.txt
gdext/api/dump-stdout.txt
native/hook-run*.txt
native/inject-received.txt

# ---- 已废弃阶段的残留（若还在，不要提交）----
.venv/
__pycache__/
uv.lock
pet-spike/node_modules/
